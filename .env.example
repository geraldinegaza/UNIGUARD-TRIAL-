# Supabase project (Project Settings -> API). The anon key is safe to expose:
# row level security is what protects the data. Never put the service_role key here.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Public URL of the deployed app. Used for the links in confirmation and
# password reset emails. Defaults to the current origin when left blank.
VITE_APP_PUBLIC_URL=""

# Web Push public key (the VAPID pair set on the push-dispatch function).
# Leave blank to keep push off; in-app notifications still work.
VITE_VAPID_PUBLIC_KEY=""

# Shown in the Offline Readiness screen so you can tell which build a device runs.
VITE_BUILD="dev"
